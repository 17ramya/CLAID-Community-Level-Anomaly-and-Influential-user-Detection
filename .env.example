# CLAID configuration - copy this file to ".env" (git-ignored) or export the
# variables in your shell. No secret is stored in the source tree.

# Signs session cookies. Leave it empty for local runs: a random key is then
# generated at startup. For a deployment set a long random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
CLAID_SECRET_KEY=

# Where the writable state lives: "data/" (the dataset extracted from the shipped
# zip) and "var/runs/" (one folder per result). Empty means the repository, which
# a read-only host cannot use - Vercel, AWS Lambda and Cloud Run therefore fall
# back to a temporary directory on their own. Point it at a mounted volume to keep
# the runs between restarts, e.g. CLAID_STATE_DIR=/data
CLAID_STATE_DIR=

# Development server binding.
CLAID_HOST=127.0.0.1
CLAID_PORT=5000

# Never enable the Flask debugger on a public interface.
CLAID_DEBUG=0
